<% layout("layouts/boilerplate") %>
<div class="row mt-1">
    <div class="col-8 offset-2">
    <h3>Create a New Listing</h3>
    <form 
    method="POST" 
    action="/listings" 
    novalidate 
    class="needs-validation"
    enctype="multipart/form-data"
    >
        <div class="mb-3">
            <label for="title" class="form-label">Title</label>
            <input 
            name="listing[title]" 
            placeholder="enter title" 
            type="text" 
            class="form-control"
            required
            />

            <div class="invalid-feedback">Title should be valid</div>
            <div class="valid-feedback">Title Looks Good!</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea 
            name="listing[description]" 
            class="form-control"
            required
            ></textarea>
            <div class="invalid-feedback">Please enter a short description</div>
        </div>
        <div class="mb-3">
            <label for="image" class="form-label">Upload Listing Image</label>
            <input 
            name="listing[image]" 
            type="file" 
            class="form-control"
            required
            />
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input name="listing[price]" 
            placeholder="enter price" 
            type="text" 
            class="form-control"  
            required      
            />
            <div class="invalid-feedback">Price should be valid</div>
        </div>
        <div class="mb-3 col-8">
            <label for="country" class="form-label">Country</label>
            <input name="listing[country]" 
            placeholder="enter country" 
            type="text"
            class="form-control" 
            required
            />
            <div class="invalid-feedback">Country name should be valid</div>
        </div>
        </div>
        <div class="mb-md-3">
            <label for="location" class="form-label">Location</label>
            <input name="listing[location]" 
            placeholder="enter location" 
            type="text" 
            class="form-control"
            required
            />
            <div class="invalid-feedback">Location should be valid</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Select Categories (Optional)</label>
            <div style="display: flex; flex-wrap: wrap; gap: 1rem;">
                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="rooms" 
                    id="cat-rooms"
                    />
                    <label class="form-check-label" for="cat-rooms">
                        Rooms
                    </label>
                </div>

                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="mountains" 
                    id="cat-mountains"
                    />
                    <label class="form-check-label" for="cat-mountains">
                        Mountains
                    </label>
                </div>

                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="castles" 
                    id="cat-castles"
                    />
                    <label class="form-check-label" for="cat-castles">
                        Castles
                    </label>
                </div>

                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="pools" 
                    id="cat-pools"
                    />
                    <label class="form-check-label" for="cat-pools">
                        Amazing Pools
                    </label>
                </div>

                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="camping" 
                    id="cat-camping"
                    />
                    <label class="form-check-label" for="cat-camping">
                        Camping
                    </label>
                </div>

                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="farms" 
                    id="cat-farms"
                    />
                    <label class="form-check-label" for="cat-farms">
                        Farms
                    </label>
                </div>

                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="arctic" 
                    id="cat-arctic"
                    />
                    <label class="form-check-label" for="cat-arctic">
                        Arctic
                    </label>
                </div>

                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="domes" 
                    id="cat-domes"
                    />
                    <label class="form-check-label" for="cat-domes">
                        Domes
                    </label>
                </div>

                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="boats" 
                    id="cat-boats"
                    />
                    <label class="form-check-label" for="cat-boats">
                        Boats
                    </label>
                </div>

                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="trending" 
                    id="cat-trending"
                    />
                    <label class="form-check-label" for="cat-trending">
                        Trending
                    </label>
                </div>

                <div class="form-check">
                    <input 
                    class="form-check-input" 
                    type="checkbox" 
                    name="listing[categories]" 
                    value="iconic_cities" 
                    id="cat-iconic"
                    />
                    <label class="form-check-label" for="cat-iconic">
                        Iconic Cities
                    </label>
                </div>
            </div>
        </div>

        <button class="btn btn-dark add-btn mt-3 mb-2">Add</button>
    </form>
    </div>
</div>

