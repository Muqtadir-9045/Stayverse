<% layout("layouts/boilerplate") %>

<style>
    #filters {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }
    .filter {
        text-align: center;
        margin-right: 2rem;
        margin-top: 2rem;
        opacity: 0.7;
        cursor: pointer;
        transition: opacity 0.3s;
    }
    @media (max-width: 767px) {
        #filters {
            flex-wrap: nowrap;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            padding-bottom: 0.5rem;
            scrollbar-width: none;
        }
        #filters::-webkit-scrollbar {
            display: none;
        }
        .filter {
            margin-right: 1.25rem;
            flex-shrink: 0;
        }
        .tax-toggle {
            flex-shrink: 0;
            margin-left: 1.25rem;
        }
    }

    .filter:hover {
        opacity: 1;
        cursor: pointer;
    }

    .filter.active {
        opacity: 1;
        border-bottom: 3px solid #fe424d;
        padding-bottom: 0.5rem;
    }

    .filter p {
        font-size : 0.8rem;
    }

    .tax-info {
        display: none;
    }

    .tax-toggle {
        border: 1px solid black;
        border-radius: 1rem;
        height: 3.5rem;
        padding: 1rem;
        margin-left: 2rem;
        display: flex;
        align-items: center;
    }

    .filter-label {
        margin-top: 1rem;
        font-size: 0.95rem;
        color: #666;
        font-weight: 500;
    }
</style>
<div id="filters">
<div class="filter <%= category === 'trending' ? 'active' : '' %>" onclick="filterListings('trending')">
    <div><i class="fa-solid fa-fire"></i></div>
    <p>Trending</p>
</div>

<div class="filter <%= category === 'rooms' ? 'active' : '' %>" onclick="filterListings('rooms')">
    <div><i class="fa-solid fa-bed"></i></div>
    <p>Rooms</p>
</div>

<div class="filter <%= category === 'iconic_cities' ? 'active' : '' %>" onclick="filterListings('iconic_cities')">
    <div><i class="fa-solid fa-mountain-city"></i></div>
    <p>Iconic cities</p>
</div>

<div class="filter <%= category === 'mountains' ? 'active' : '' %>" onclick="filterListings('mountains')">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p>Mountains</p>
</div>

<div class="filter <%= category === 'castles' ? 'active' : '' %>" onclick="filterListings('castles')">
    <div><i class="fa-brands fa-fort-awesome"></i></div>
    <p>Castles</p>
</div>

<div class="filter <%= category === 'pools' ? 'active' : '' %>" onclick="filterListings('pools')">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p>Amazing Pools</p>
</div>

<div class="filter <%= category === 'camping' ? 'active' : '' %>" onclick="filterListings('camping')">
    <div><i class="fa-solid fa-campground"></i></div>
    <p>Camping</p>
</div>

<div class="filter <%= category === 'farms' ? 'active' : '' %>" onclick="filterListings('farms')">
    <div><i class="fa-solid fa-cow"></i></div>
    <p>Farms</p>
</div>

<div class="filter <%= category === 'arctic' ? 'active' : '' %>" onclick="filterListings('arctic')">
    <div><i class="fa-solid fa-snowflake"></i></div>
    <p>Arctic</p>
</div>

<div class="filter <%= category === 'domes' ? 'active' : '' %>" onclick="filterListings('domes')">
    <div><i class="fa-solid fa-igloo"></i></div>
    <p>Domes</p>
</div>

<div class="filter <%= category === 'boats' ? 'active' : '' %>" onclick="filterListings('boats')">
    <div><i class="fa-solid fa-ship"></i></div>
    <p>Boats</p>
</div>

<div class="tax-toggle">
<div class="form-check-reverse form-switch">
    <input 
    class="form-check-input" 
    type="checkbox" 
    role="switch" 
    id="flexSwitchCheckDefault"
    />
    <label class="form-check-label" for="flexSwitchCheckDefault">
        Display total after taxes</label>
</div>
</div>
</div>
<% if (category) { %>
<div class="filter-label">Showing <%= total %> <%= category.replace(/_/g, ' ') %> listings
<a href="/listings" style="margin-left: 1rem; text-decoration: underline; color: #fe424d;">Clear Filter</a>
</div>
<% } %>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 mt-3" id="listingGrid">
    <%- include("../includes/listingCards.ejs", { listings : allListings, offset : 0 }) %>
</div>
<% if (hasMore) { %>
<div class="text-center my-4">
    <button class="btn btn-dark" id="loadMoreBtn" data-next-page="2">Load more</button>
</div>
<% } %>
<script>
    function filterListings(categoryName) {
        window.location.href = `/listings?category=${categoryName}`;
    }

    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    function applyTaxToggle() {
        for (let info of document.getElementsByClassName("tax-info")) {
            info.style.display = taxSwitch.checked ? "inline" : "none";
        }
    }
    taxSwitch.addEventListener("change", applyTaxToggle);

    let loadMoreBtn = document.getElementById("loadMoreBtn");
    if (loadMoreBtn) {
        loadMoreBtn.addEventListener("click", async () => {
            let params = new URLSearchParams(window.location.search);
            params.set("page", loadMoreBtn.dataset.nextPage);
            params.set("partial", "1");
            loadMoreBtn.disabled = true;
            loadMoreBtn.textContent = "Loading...";
            try {
                let res = await fetch(`/listings?${params}`);
                if (!res.ok) throw new Error("request failed");
                document.getElementById("listingGrid").insertAdjacentHTML("beforeend", await res.text());
                applyTaxToggle();
                if (res.headers.get("X-Has-More") === "true") {
                    loadMoreBtn.dataset.nextPage = Number(loadMoreBtn.dataset.nextPage) + 1;
                    loadMoreBtn.disabled = false;
                    loadMoreBtn.textContent = "Load more";
                } else {
                    loadMoreBtn.remove();
                }
            } catch (e) {
                loadMoreBtn.disabled = false;
                loadMoreBtn.textContent = "Load more";
            }
        });
    }
</script>